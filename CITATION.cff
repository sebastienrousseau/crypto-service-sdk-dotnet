repository-code: "https://github.com/sebastienrousseau/crypto-service-sdk-dotnet"
url: "https://crypto-service.co"
keywords:
  - cryptography
  - post-quantum
  - ML-KEM
  - ML-DSA
  - .NET
  - SDK
