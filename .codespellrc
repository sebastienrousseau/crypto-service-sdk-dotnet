# codespell, as the docs-lint workflow and pre-commit run it.
[codespell]
skip = ./.git,./.venv-lint,./.venv-docs,*/bin,*/obj,./artifacts,./site,./docs/api,*.lock.json,*.gif,./conformance,./ci/*.txt,./docs/requirements.txt,./LICENSES,./LICENSE-APACHE,./fuzz/corpus
check-hidden = true
